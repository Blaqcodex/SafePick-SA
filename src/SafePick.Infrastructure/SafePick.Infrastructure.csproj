<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SafePick.Infrastructure — Adapters to the outside world.
    Contains: EF Core persistence, outbox, email channel, PDF generation, time.
    Dependencies: Application (which transitively includes Domain).
  -->

  <PropertyGroup>
    <RootNamespace>SafePick.Infrastructure</RootNamespace>
    <AssemblyName>SafePick.Infrastructure</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Migration files are auto-generated by EF Core. They use array
      literals that violate CA1861 — a performance rule that does not
      apply to code that runs once, at migration time.
      Suppressed project-wide; every other analyzer still applies.
    -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafePick.Application\SafePick.Application.csproj" />
  </ItemGroup>

  <!-- ASP.NET Core shared framework — provides IHttpContextAccessor,
       Microsoft.Extensions.Hosting.*, Microsoft.Extensions.Options.*,
       System.Security.Cryptography.Xml (patched in .NET 10), etc. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="MimeKit" Version="4.16.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
  </ItemGroup>

    <!-- Notification templates are copied to the build output so
       FileTemplateRenderer can read them at runtime. -->
  <ItemGroup>
    <Content Include="Notifications\Templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Notifications\Templates\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>